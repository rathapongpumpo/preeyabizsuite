{
  "rewrites": [
    {
      "source": "/external/ecommerce/:path*",
      "destination": "https://ecommerce-codex-demo.vercel.app/:path*"
    },
    {
      "source": "/external/tilt/:path*",
      "destination": "https://tilt-signal-arcade-bar.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
