{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/external/ecommerce/:path*",
      "destination": "https://ecommerce-codex-demo.vercel.app/:path*"
    },
    {
      "source": "/external/tilt/:path*",
      "destination": "https://openai-landing-page-examples.vercel.app/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/warehouse-management",
      "destination": "/route-pages/warehouse-management.html"
    },
    {
      "source": "/pos-system-smart",
      "destination": "/route-pages/pos-system-smart.html"
    },
    {
      "source": "/business-suite",
      "destination": "/route-pages/business-suite.html"
    },
    {
      "source": "/usa-thai-shipping",
      "destination": "/route-pages/usa-thai-shipping.html"
    },
    {
      "source": "/tilt-signal-arcade-bar",
      "destination": "/route-pages/tilt-signal-arcade-bar.html"
    },
    {
      "source": "/ecommerce-storefront",
      "destination": "/route-pages/ecommerce-storefront.html"
    },
    {
      "source": "/e-signature",
      "destination": "/route-pages/e-signature.html"
    },
    {
      "source": "/usa-thai-shipping/admin",
      "destination": "/route-pages/usa-thai-shipping--admin.html"
    },
    {
      "source": "/usa-thai-shipping/customer",
      "destination": "/route-pages/usa-thai-shipping--customer.html"
    },
    {
      "source": "/(.*)",
      "destination": "/demo.html"
    }
  ]
}
